{
  "schema": "esgpro-theme/1.0",
  "name": "ESGPro Mastery Institute - practitioner series",
  "note": "Palette locked to the original CCMP Brochure 2.0. Programme files cannot override colours, fonts or page backgrounds.",
  "page": {
    "width": 720,
    "height": 960,
    "margin": 42,
    "top_bar": 8,
    "header_logo_box": [42, 22, 250, 50],
    "header_label_y": 40,
    "content_top": 104,
    "footer_rule_y": 915,
    "footer_text_y": 926,
    "content_bottom": 900,
    "block_gap": 20,
    "inner_gap": 12,
    "underfill_warning_ratio": 0.22
  },
  "page_backgrounds": {
    "cover": "paper",
    "standard": "paper"
  },
  "colors": {
    "forest": "#1A5D49",
    "forest_deep": "#134536",
    "forest_2": "#2E7A61",
    "forest_3": "#4E957A",
    "lime": "#6BC149",
    "lime_dark": "#3F8F2A",
    "gold": "#C3A746",
    "gold_tint": "#EBE6CF",
    "paper": "#F4F4F4",
    "white": "#FFFFFF",
    "mist": "#E8EFE9",
    "mist_2": "#D6E4DA",
    "ink": "#1A1A1A",
    "muted": "#55635C",
    "rule": "#CBD5CF",
    "on_dark": "#FFFFFF",
    "on_dark_muted": "#CFE3D8",
    "on_dark_label": "#A9E08F"
  },
  "series": ["#1A5D49", "#6BC149", "#C3A746", "#4E957A", "#9BB8AA", "#134536"],
  "fonts": {
    "Sans": "fonts/Carlito-Regular.ttf",
    "SansBold": "fonts/Carlito-Bold.ttf",
    "SansItalic": "fonts/Carlito-Italic.ttf",
    "Serif": "fonts/Caladea-Regular.ttf",
    "SerifBold": "fonts/Caladea-Bold.ttf",
    "SerifItalic": "fonts/Caladea-Italic.ttf"
  },
  "styles": {
    "kicker":        {"font": "SansBold", "size": 8.5, "leading": 11, "color": "forest", "tracking": 1.3},
    "meta":          {"font": "SansBold", "size": 7.5, "leading": 10, "color": "muted", "tracking": 1.2},
    "h1":            {"font": "Serif", "size": 35, "leading": 38, "color": "forest"},
    "h1_em":         {"font": "SerifItalic", "size": 35, "leading": 38, "color": "forest"},
    "sub":           {"font": "Sans", "size": 13, "leading": 17.5, "color": "muted"},
    "lead":          {"font": "Sans", "size": 13.5, "leading": 19.5, "color": "ink"},
    "body":          {"font": "Sans", "size": 11, "leading": 15.4, "color": "ink"},
    "small":         {"font": "Sans", "size": 9.8, "leading": 13.4, "color": "ink"},
    "caption":       {"font": "Sans", "size": 8, "leading": 11, "color": "muted"},
    "h2":            {"font": "Serif", "size": 22, "leading": 26, "color": "forest"},
    "h3":            {"font": "SansBold", "size": 12.2, "leading": 15.5, "color": "forest"},
    "h4":            {"font": "SansBold", "size": 10.5, "leading": 13.5, "color": "forest"},
    "chev":          {"font": "SansBold", "size": 10, "leading": 12, "color": "white"},
    "kpi":           {"font": "SansBold", "size": 30, "leading": 32, "color": "forest"},
    "kpi_sm":        {"font": "SansBold", "size": 20, "leading": 22, "color": "forest"},
    "kpi_label":     {"font": "Sans", "size": 10, "leading": 13, "color": "ink"},
    "stat_xl":       {"font": "Serif", "size": 50, "leading": 52, "color": "forest"},
    "quote":         {"font": "SerifItalic", "size": 11.5, "leading": 16, "color": "ink"},
    "pull_quote":    {"font": "SerifItalic", "size": 17, "leading": 23, "color": "forest"},
    "price":         {"font": "SansBold", "size": 36, "leading": 38, "color": "forest"},
    "price_sm":      {"font": "SansBold", "size": 22, "leading": 24, "color": "forest"},
    "button":        {"font": "SansBold", "size": 11, "leading": 13, "color": "forest_deep"},
    "cta_title":     {"font": "Serif", "size": 24, "leading": 28, "color": "white"},
    "callout_title": {"font": "Serif", "size": 17, "leading": 21, "color": "white"},
    "cover_kicker":  {"font": "SansBold", "size": 9, "leading": 12, "color": "forest", "tracking": 1.5},
    "cover_title":   {"font": "Serif", "size": 50, "leading": 52, "color": "forest"},
    "cover_em":      {"font": "SerifItalic", "size": 34, "leading": 38, "color": "forest"},
    "cover_sub":     {"font": "Sans", "size": 15, "leading": 20, "color": "ink"},
    "cover_lead":    {"font": "Sans", "size": 12, "leading": 17, "color": "muted"},
    "footer":        {"font": "Sans", "size": 7.5, "leading": 10, "color": "muted", "tracking": 0.4},
    "footer_num":    {"font": "SansBold", "size": 8.5, "leading": 10, "color": "muted"}
  },
  "image_rules": {
    "default_max_uses": {"logo": null, "portrait": 1, "photo": 1, "partner_logo": 1},
    "near_duplicate_hamming": 6,
    "min_effective_ppi": 150
  },
  "infographic_blocks": ["kpi_row", "process_flow", "timeline", "module_grid", "icon_grid", "comparison", "ladder", "bar_chart", "donut", "stat_band", "matrix_2x2", "pricing", "evidence_table", "testimonials", "mentor", "week_plan"],
  "design_rules": {
    "max_title_lines": 2,
    "require_infographic_per_page": true,
    "max_same_block_type_pages": 2
  }
}
